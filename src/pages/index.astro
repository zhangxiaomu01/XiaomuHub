---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// 首页对齐旧站 Home：完整展示精选（近期）项目，旧项目在 /projects/
const featured = (await getCollection('projects', ({ data }) => !data.draft && data.featured))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const rendered = await Promise.all(
  featured.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);
---

<BaseLayout title="XiaomuHub · 张小木的个人网站">
  <section class="hero">
    <h1>你好，我是张小木（Jun Zhang）</h1>
    <p>
      欢迎来到我的网站。过去几年里，我一直在计算机图形学的方向上深耕：3D 建模、贴图、Python 工具链与图形渲染，
      也熟悉 C++ 编程和 OpenGL 相关技术；目前正在学习 OpenGL/Vulkan 方面更进阶的内容。
      这里展示我的项目作品，也记录一些技术笔记与生活里的想法。
    </p>
  </section>

  <section>
    <h2 class="home-overview-title">项目总览（Projects Overview）</h2>
    <p class="home-overview-intro">以下是我近年来完成的项目，点击标题可查看完整介绍：</p>

    {
      rendered.map(({ entry, Content }) => (
        <article class="home-project">
          <h3>
            <a href={`/projects/${entry.id}/`}>{entry.data.title}</a>
          </h3>
          <div class="meta">
            {entry.data.period && <span>{entry.data.period}</span>}
            {entry.data.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
          <div class="prose">
            <Content />
          </div>
        </article>
      ))
    }

    <div class="home-links">
      <p>
        📦 想了解我更早的项目与公司作品，请移步
        <a href="/projects/">全部项目</a>；
        🎨 我的个人数字艺术作品收录在
        <a href="/blog/gallery/">数字艺术作品集</a>
        ；✍️ 技术与生活随笔见 <a href="/blog/">博客</a>。
      </p>
    </div>
  </section>
</BaseLayout>
