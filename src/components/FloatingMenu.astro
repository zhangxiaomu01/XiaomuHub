---
import { getCollection } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

// 全站悬浮菜单：近期文章 + 关键词搜索（标题/标签）
const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const recentPosts = allPosts.slice(0, 3);

// 搜索索引：内联到页面，客户端按标题/标签过滤
const searchIndex = allPosts.map((post) => ({
  title: post.data.title,
  url: `/blog/${post.id}/`,
  tags: post.data.tags,
  dateLabel: post.data.pubDate.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }),
}));
---

<div class="floating-menu" data-floating-menu>
  <button
    type="button"
    class="floating-menu__fab"
    data-floating-menu-toggle
    aria-expanded="false"
    aria-controls="floating-menu-panel"
    aria-label="近期文章"
    title="近期文章"
  >
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-4 0V7" />
      <path d="M18 14h-8" />
      <path d="M15 18h-5" />
      <path d="M10 6h8v4h-8z" />
    </svg>
  </button>

  <div class="floating-menu__panel" id="floating-menu-panel" hidden>
    <div class="floating-menu__header">
      <span>近期文章</span>
      <button
        type="button"
        class="floating-menu__close"
        data-floating-menu-close
        aria-label="关闭"
      >
        ×
      </button>
    </div>

    <div class="floating-menu__body">
      <script type="application/json" id="floating-menu-index" set:html={JSON.stringify(searchIndex).replace(/</g, '\\u003c')} />

      <div class="floating-menu__search">
        <input
          type="search"
          placeholder="搜索文章（标题/标签）…"
          aria-label="搜索文章"
          data-floating-menu-search
        />
      </div>

      <ul class="floating-menu__posts" data-floating-menu-posts>
        {
          recentPosts.map((post) => (
            <li>
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              <FormattedDate date={post.data.pubDate} />
            </li>
          ))
        }
      </ul>

      <div class="floating-menu__links">
        <a class="floating-menu__more" href="/blog/">全部文章 →</a>
        <a class="floating-menu__more" href="/">返回首页 →</a>
      </div>
    </div>
  </div>
</div>

<script>
  const menu = document.querySelector<HTMLElement>('[data-floating-menu]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-floating-menu-toggle]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-floating-menu-close]');
  const panel = document.getElementById('floating-menu-panel');
  const searchInput = document.querySelector<HTMLInputElement>('[data-floating-menu-search]');
  const postsList = document.querySelector<HTMLUListElement>('[data-floating-menu-posts]');
  const indexEl = document.getElementById('floating-menu-index');

  if (menu && toggle && panel) {
    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      menu.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
    };

    toggle.addEventListener('click', () => {
      setOpen(panel.hidden);
    });

    closeBtn?.addEventListener('click', () => setOpen(false));

    // 点击面板外部关闭
    document.addEventListener('click', (event) => {
      if (!menu.contains(event.target as Node)) setOpen(false);
    });

    // Esc 关闭
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !panel.hidden) setOpen(false);
    });
  }

  // 关键词搜索：按标题/标签过滤，清空恢复近期文章列表
  if (searchInput && postsList && indexEl) {
    type Post = { title: string; url: string; tags: string[]; dateLabel: string };
    let posts: Post[] = [];
    try {
      posts = JSON.parse(indexEl.textContent ?? '[]');
    } catch {
      posts = [];
    }
    const initialHtml = postsList.innerHTML;

    searchInput.addEventListener('input', () => {
      const query = searchInput.value.trim().toLowerCase();

      if (!query) {
        postsList.innerHTML = initialHtml;
        return;
      }

      const matches = posts
        .filter(
          (post) =>
            post.title.toLowerCase().includes(query) ||
            post.tags.some((tag) => tag.toLowerCase().includes(query)),
        )
        .slice(0, 8);

      postsList.replaceChildren();

      if (matches.length === 0) {
        const empty = document.createElement('li');
        empty.className = 'floating-menu__empty';
        empty.textContent = '没有匹配的文章';
        postsList.append(empty);
        return;
      }

      for (const post of matches) {
        const li = document.createElement('li');
        const link = document.createElement('a');
        link.href = post.url;
        link.textContent = post.title;
        const date = document.createElement('span');
        date.className = 'floating-menu__date';
        date.textContent = post.dateLabel;
        li.append(link, date);
        postsList.append(li);
      }
    });
  }
</script>
