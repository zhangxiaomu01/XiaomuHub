---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  // Markdown 页面（src/pages/*.md）会传入 frontmatter
  frontmatter?: { title?: string; description?: string };
}

const props = Astro.props;
const {
  title = 'XiaomuHub',
  description = '张小木（Jun Zhang）的个人网站：项目作品、技术博客与生活想法',
} = {
    title: props.frontmatter?.title ?? props.title,
    description: props.frontmatter?.description ?? props.description,
  };
const isMarkdownPage = !!props.frontmatter;

const navItems = [
  { href: '/', label: '首页' },
  { href: '/projects/', label: '项目' },
  { href: '/blog/', label: '博客' },
  { href: '/about/', label: '关于' },
];

const { pathname } = Astro.url;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="site-brand" href="/">XiaomuHub</a>
        <nav class="site-nav">
          {
            navItems.map((item) => (
              <a href={item.href} class={isActive(item.href) ? 'active' : ''}>
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main>
      <div class="container">
        {isMarkdownPage ? <div class="page-header"><h1>{title}</h1></div><div class="prose"><slot /></div> : <slot />}
      </div>
    </main>

    <footer class="site-footer">
      <div class="container">
        © {new Date().getFullYear()} Jun Zhang · 由
        <a href="https://astro.build/" target="_blank" rel="noopener">Astro</a>
        驱动
      </div>
    </footer>
  </body>
</html>
